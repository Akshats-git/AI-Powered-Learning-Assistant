PORT=8000
MONGO_URI=<atlas connection string>
JWT_SECRET=<long random string>
CLIENT_URL=http://localhost:5173

# Optional: the deployer's own key, used as a shared fallback for any user
# who hasn't saved their own OpenAI key on their Profile page (see
# openaiApiKeyEncrypted on the User model, and middlewares/aiKeyContext.js).
# Every user's own key always wins over this when they have one. Leave unset
# to run this app "bring-your-own-key only" — nobody's requests cost you
# anything, but AI features stay off until a user adds their own key.
# Spend against THIS key (never a user's own) is capped by
# MONTHLY_AI_BUDGET_USD below and is what the admin cost dashboard shows.
OPENAI_API_KEY=<openai api key>
OPENAI_MODEL=gpt-4o-mini

# Required to encrypt a user's saved OpenAI key at rest (AES-256-GCM — see
# utils/encryption.js). Any long random string works; generate one with
# `openssl rand -hex 32`. Falls back to deriving a key from JWT_SECRET if
# unset, which is fine for local dev but should always be set explicitly (and
# different from JWT_SECRET) in production.
ENCRYPTION_KEY=<long random string, different from JWT_SECRET>

# Optional: caps how much of YOUR money (the shared OPENAI_API_KEY above) each
# user can spend per calendar month. Never applies to a user spending their
# own saved key — that's their money, not yours. Unset = no cap.
MONTHLY_AI_BUDGET_USD=5

# Optional: access token lifetime (short — it's the bearer token sent on every
# request) and refresh token lifetime (long — it only ever lives in an
# httpOnly cookie and is used to mint new access tokens).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Optional: sign refresh tokens with a different secret than access tokens.
# Unset = falls back to JWT_SECRET.
REFRESH_TOKEN_SECRET=<long random string, different from JWT_SECRET>

# Optional: lock a login out for ACCOUNT_LOCK_MINUTES after this many
# consecutive wrong passwords. Defaults: 5 attempts, 15 minutes.
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Optional: comma-separated emails allowed to hit /api/admin/* (the cost
# dashboard). Unset = nobody can. Not a stored role — checked fresh from this
# env var on every request, so promoting/demoting is a config change.
ADMIN_EMAILS=you@example.com

# Optional: sends password-reset (and future transactional) emails via
# Resend's API (https://resend.com). Unset = the email is logged instead of
# sent, so the reset flow still works end-to-end in dev without a real
# provider — just copy the link from the server log.
RESEND_API_KEY=<resend api key>
MAIL_FROM=onboarding@resend.dev

# Optional: caps how many pages an OCR fallback (scanned/image-only PDFs)
# will render and recognize during upload. OCR is synchronous today (no job
# queue yet), so this bounds how long one upload request can take. Default: 25.
OCR_MAX_PAGES=25

# Optional: SameSite for the refresh-token and CSRF cookies. Default "lax" is
# correct when the frontend and backend are on the same domain (including
# subdomains of the same registrable domain, e.g. app.example.com talking to
# api.example.com). Set to "none" if they're on genuinely different domains
# (e.g. a Vercel *.vercel.app frontend + a Render *.onrender.com backend) —
# otherwise the browser silently drops these cookies on cross-site requests
# and users get logged out every time the access token expires. "none"
# requires HTTPS, which every mainstream host provides by default.
COOKIE_SAME_SITE=lax
